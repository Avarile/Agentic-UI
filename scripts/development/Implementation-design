## Stage 1 — `LabelFactory` generation and sweep

**Why now.** It is a latent leak *today*, independent of everything else, and it is
the hard prerequisite for Stage 4. One `<canvas>` + `CanvasTexture` +
`MeshBasicMaterial` per distinct string (`labels.ts:85-146`), freed only by
`dispose()` at scene unmount (`Scene.tsx:146`). No generation counter, no eviction,
no `delete`.

### The change

Mirror `MaterialRegistry` (`materials.ts:181`, `:286`) exactly, including the
two-generation grace that lets a string vanish for one build and return free.

```ts
// client/src/components/SystemCore/scene/labels.ts

/**
 * When the cache is bigger than this, something is feeding it a continuous value.
 *
 * Bounded by the number of *distinct* strings the scene can ask for: one name per
 * module, plus one ticker per module. A few hundred is generous. The same reasoning
 * and the same backstop as MAX_MATERIALS in ./materials.ts.
 */
export const MAX_LABELS = 128;

export class LabelFactory {
  private readonly cache = new Map<string, THREE.MeshBasicMaterial>();
  private readonly anisotropy: number;
  private gen = 0;

  get size(): number {
    return this.cache.size;
  }

  /** The fixed band name. Shared by string — the codomain is the module names. */
  get(text: string): THREE.MeshBasicMaterial {
    return this.material('name\u0000' + text, text, false);
  }

  /**
   * The scrolling readout.
   *
   * Keyed by id as well as text, so no two strips are ever handed the same
   * texture. `offset.x` is advanced once per frame by whichever strip owns the
   * mesh, and a shared texture would be advanced once per sharer — two modules
   * whose readings happened to format identically would scroll at double rate.
   */
  ticker(id: string, text: string): THREE.MeshBasicMaterial {
    return this.material('ticker\u0000' + id + '\u0000' + text, text, true);
  }

  private material(key: string, text: string, repeating: boolean): THREE.MeshBasicMaterial {
    const found = this.cache.get(key);
    if (found) {
      // Stamped on the hit as well as the miss: a material still in use has to
      // look used, or the next sweep disposes it out from under a live mesh.
      found.userData.gen = this.gen;
      return found;
    }
    const mat = this.rasterize(text, repeating);
    mat.userData.gen = this.gen;
    this.cache.set(key, mat);
    return mat;
  }

  /**
   * Releases what the last build stopped asking for, and opens a generation.
   *
   * After the commit, never during render and never per frame — a disposed
   * texture still referenced by a mesh that has just rendered draws blank.
   */
  sweep(): void {
    const floor = this.gen - 1;
    for (const [key, mat] of this.cache) {
      if ((mat.userData.gen as number) >= floor) {
        continue;
      }
      mat.map?.dispose();
      mat.dispose();
      this.cache.delete(key);
    }
    this.gen += 1;
    if (this.cache.size > MAX_LABELS) {
      logger.warn(
        'system_core',
        `label cache holds ${this.cache.size} entries (cap ${MAX_LABELS}); ` +
          'a string with an unbounded codomain is probably reaching LabelFactory',
      );
    }
  }
}
```

The existing body of `get()` becomes `private rasterize(text, repeating)`, with two
additions at the end:

```ts
    if (repeating) {
      tex.wrapS = THREE.RepeatWrapping;
    }
```

